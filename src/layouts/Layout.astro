---
import "@enapter/design-tokens/colors.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Cookies from "../components/Cookies.astro";

interface Props {
  title: string;
  description: string;
  alt: string;
}

const { title, description, alt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Begin Inspectlet Asynchronous Code -->
    <script is:inline type="text/javascript">
      (function () {
        window.__insp = window.__insp || [];
        __insp.push(["wid", 416782029]);
        var ldinsp = function () {
          if (typeof window.__inspld != "undefined") return;
          window.__inspld = 1;
          var insp = document.createElement("script");
          insp.type = "text/javascript";
          insp.async = true;
          insp.id = "inspsync";
          insp.src =
            ("https:" == document.location.protocol ? "https" : "http") +
            "://cdn.inspectlet.com/inspectlet.js?wid=416782029&r=" +
            Math.floor(new Date().getTime() / 3600000);
          var x = document.getElementsByTagName("script")[0];
          x.parentNode.insertBefore(insp, x);
        };
        setTimeout(ldinsp, 0);
      })();
    </script><!-- End Inspectlet Asynchronous Code -->

    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });

        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s) as HTMLScriptElement,
          dl = l != "dataLayer" ? "&l=" + l : "";

        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-5ZWCJ4ST");
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <!-- Keywords (optional, but helps some crawlers) -->
    <meta name="keywords" content="Enapter EMS Toolkit 3.0, Low-Code Energy Management, Open-Source EMS, Hydrogen Energy Control, Microgrid Optimization, REST API for Energy Systems">

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Canonical URL (important for SEO) -->
    <link rel="canonical" href="https://3.enapter.cloud/" />

    <!-- Open Graph Meta Tags for Facebook -->
    <meta property="og:url" content="https://3.enapter.cloud/" />
    <meta property="og:domain" content="3.enapter.cloud" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Enapter Energy Management System Toolkit 3.0">
    <meta
      property="og:title"
      content="Take Your Energy Management to the Next Level with Enapter EMS Toolkit 3.0"
    />
    <meta
      property="og:description"
      content="Enapter EMS Toolkit 3.0 offers local-first, low-code, open-source solutions for smart energy management. It empowers developers to create intelligent, secure, and efficient energy management systems for both energy production and consumption."
    />

    <meta property="og:image" content="https://3.enapter.cloud/ems-light.png" />
    <meta property="og:image:alt" content={alt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:logo" content="https://3.enapter.cloud/logo.png" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="3.enapter.cloud/" />
    <meta name="twitter:url" content="https://3.enapter.cloud/" />
    <meta
      name="twitter:title"
      content="Take Your Energy Management to the Next Level with Enapter EMS Toolkit 3.0"
    />
    <meta
      name="twitter:description"
      content="Enapter EMS Toolkit 3.0 offers local-first, low-code, open-source solutions for smart energy management. It empowers developers to create intelligent, secure, and efficient energy management systems for both energy production and consumption."
    />
    <meta
      name="twitter:image"
      content="https://3.enapter.cloud/ems-light.png"
    />
    <meta name="twitter:image:alt" content={alt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=block"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      html,
      body {
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          "Helvetica Neue",
          Arial,
          "Noto Sans",
          sans-serif,
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "Noto Color Emoji";
        scrollbar-gutter: stable;
      }

      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
    </style>
  </head>
  <body
    class="bg-background2 min-h-[100dvh] flex flex-col px-4 md:px-12 lg:max-w-7xl mx-auto stable"
  >
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5ZWCJ4ST"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <Header />
    <slot />
    <Footer />
    <Cookies />
  </body>
</html>
