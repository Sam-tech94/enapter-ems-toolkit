<form
  action="/send.php"
  method="post"
  id="newsletter"
  name="newsletter"
  novalidate
  autocomplete="off"
  aria-labelledby="form-heading"
>
  <h2 id="form-heading" class="sr-only">Newsletter Sign-up</h2>
  <div class="grid gap-4 grid-cols-1 lg:grid-cols-[1fr,auto]">
    <label for="signup-email" class="sr-only">Email Address</label>
    <input
      class="inspectlet-sensitive border bg-background2 border-border py-3 px-4 appearance-none rounded-xl placeholder:text-gray1 placeholder:text-base placeholder:font-semibold placeholder:tracking-[0.4px] text-text outline-none focus:border-borderFocus hover:border-borderHover invalid:[&:not(:placeholder-shown):not(:focus)]:border-redCF w-full caret-blueCF"
      type="email"
      name="signup-email"
      id="signup-email"
      placeholder="Email"
      required
      aria-describedby="email-description"
      aria-invalid="false"
      aria-required="true" 
    />
    <p id="email-description" class="sr-only">
      Please enter your email address to sign up for the newsletter.
    </p>
    <input
      type="submit"
      value="Notify Me"
      name="signup-button"
      id="signup-button"
      class="bg-blue py-3 px-4 rounded-xl cursor-pointer text-white text-base font-medium tracking-wide hover:bg-blueHover hover:transition-colors hover:duration-300 active:bg-blueActive w-full md:w-auto"
      aria-label="Submit your email to receive notifications"
    />
  </div>

  <div id="response" class="mt-2 hidden col-span-2" aria-live="polite">
    <p id="response-message" class="text-sm" role="alert"></p>
  </div>
</form>

<script>
  document
    .getElementById("newsletter")
    .addEventListener("submit", async function (event) {
      event.preventDefault();

      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);
      const responseElement = document.getElementById("response");
      const messageElement = document.getElementById("response-message");
      messageElement.innerHTML = "";
      responseElement.classList.add("hidden");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.status === "error") {
          messageElement.innerHTML = result.message;
          messageElement.classList.remove("text-greenCF");
          messageElement.classList.add("text-redCF");
          messageElement.setAttribute("aria-live", "assertive");
        } else {
          messageElement.innerHTML = result.message;
          messageElement.classList.remove("text-redCF");
          messageElement.classList.add("text-greenCF");
          messageElement.setAttribute("aria-live", "assertive");
          form.reset();
        }

        responseElement.classList.remove("hidden");
      } catch (error) {
        console.error("Error:", error);
        messageElement.innerHTML = "An error occurred, please try again later.";
        messageElement.classList.remove("text-greenCF");
        messageElement.classList.add("text-redCF");
        messageElement.setAttribute("aria-live", "assertive");
        responseElement.classList.remove("hidden");
      }
    });
</script>
