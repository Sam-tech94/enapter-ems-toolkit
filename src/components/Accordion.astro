<script>
  const accordion = document.querySelector(".accordion");

  accordion.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest("h2, button, svg");
    if (!target) return;

    const activePanel = target.closest(".accordion-panel");
    if (!activePanel) return;

    toggleAccordion(activePanel);
  });

  function toggleAccordion(panelToActivate) {
    const activeButton = panelToActivate.querySelector("button");
    const activePanelIsOpened =
      activeButton.getAttribute("aria-expanded") === "true";
    const isFirstChild = panelToActivate === accordion.firstElementChild;

    if (activePanelIsOpened) {
      activeButton.setAttribute("aria-expanded", "false");
      panelToActivate
        .querySelector(".accordion-content")
        .setAttribute("aria-hidden", "true");
      panelToActivate.classList.remove("open");
      if (isFirstChild) panelToActivate.style.backgroundColor = "transparent";
    } else {
      activeButton.setAttribute("aria-expanded", "true");
      panelToActivate
        .querySelector(".accordion-content")
        .setAttribute("aria-hidden", "false");
      panelToActivate.classList.add("open");
      if (isFirstChild) {
        panelToActivate.style.backgroundColor = "var(--color-background3)";
      }
    }
  }
</script>
