---
import ArchitectureImage from "./ArchitectureImage.astro";
---

<section
  class="flex flex-col-reverse gap-10 mb-16 md:mb-24 md:flex-row md:gap-20"
  aria-labelledby="architecture-heading"
>
  <div class="flex flex-col gap-4 max-w-[440px] w-full">
    <h2 id="architecture-heading" class="text-text text-3xl font-bold">
      Architecture
    </h2>
    <p
      class="text-textGray2 text-lg"
      aria-label="Enapter UCMs send and receive measurement and control data over a secure wireless channel from various sensors and energy resources."
    >
      Enapter UCMs send and receive measurement and control data over a secure
      wireless channel from various sensors and energy resources.
    </p>
    <p
      class="text-textGray2 text-lg"
      aria-label="Open-source, local-first intelligent gateway that enables secure data routing, mitigates connectivity issues, automates, and provides integration interfaces such as OPC UA, MQTT, and REST API."
    >
      Open-source, local-first intelligent gateway that enables secure data
      routing, mitigates connectivity issues, automates, and provides
      integration interfaces such as OPC UA, MQTT, and REST API.
    </p>
    <p
      class="text-textGray2 text-lg"
      aria-label="Enapter Cloud provides efficient and secure long-term storage for device data and AI-powered tools for data analysis, modeling, and visualization."
    >
      Enapter Cloud provides efficient and secure long-term storage for device
      data and AI-powered tools for data analysis, modeling, and visualization.
    </p>
  </div>
  <ArchitectureImage />
</section>
